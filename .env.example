# ============================================
# DocDist 环境配置示例
# 复制此文件为 .env 并根据需要修改配置
# ============================================

# --------------------------------------------
# 基础配置 (必填)
# --------------------------------------------

# JWT 密钥 - 生产环境必须设置为强密码
# 建议使用: openssl rand -hex 32
SECRET_KEY=your-secret-key-here

# 数据库连接 URL
# SQLite: sqlite:///./data/docdist.db
# PostgreSQL: postgresql://user:password@localhost/docdist
DATABASE_URL=sqlite:///./data/docdist.db

# 文件上传目录
UPLOAD_DIR=./data/uploads

# --------------------------------------------
# 安全配置
# --------------------------------------------

# Access Token 过期时间 (分钟)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 最大文件大小 (字节)
# 52428800 = 50MB
MAX_FILE_SIZE=52428800

# 允许上传的文件类型 (逗号分隔)
ALLOWED_FILE_TYPES=.pdf,.docx,.xlsx

# --------------------------------------------
# 性能配置
# --------------------------------------------

# 最大工作进程数
MAX_WORKERS=4

# Diff 引擎超时时间 (秒)
DIFF_ENGINE_TIMEOUT=300

# 请求体最大大小 (字节)
# 104857600 = 100MB
MAX_REQUEST_BODY_SIZE=104857600

# --------------------------------------------
# 日志配置
# --------------------------------------------

# 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# 日志保留天数
LOG_RETENTION_DAYS=30

# 日志文件路径 (可选，默认输出到控制台)
# LOG_FILE=/var/log/docdist/app.log

# --------------------------------------------
# CORS 配置
# --------------------------------------------

# 允许的源 (逗号分隔，* 表示允许所有)
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# 是否允许携带凭证
CORS_ALLOW_CREDENTIALS=true

# --------------------------------------------
# 邮件通知配置 (可选)
# --------------------------------------------

# SMTP 服务器配置
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# 通知邮箱地址
NOTIFY_EMAIL=

# 是否启用邮件通知
ENABLE_EMAIL_NOTIFICATION=false

# --------------------------------------------
# 存储配置 (可选)
# --------------------------------------------

# 存储类型: local, s3, oss
STORAGE_TYPE=local

# AWS S3 配置 (当 STORAGE_TYPE=s3 时必填)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# S3_BUCKET=

# 阿里云 OSS 配置 (当 STORAGE_TYPE=oss 时必填)
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_ENDPOINT=
# OSS_BUCKET=

# --------------------------------------------
# 缓存配置 (可选)
# --------------------------------------------

# 缓存类型: memory, redis
CACHE_TYPE=memory

# Redis 配置 (当 CACHE_TYPE=redis 时必填)
# REDIS_URL=redis://localhost:6379/0

# 缓存过期时间 (秒)
CACHE_EXPIRE_SECONDS=3600

# --------------------------------------------
# 高级配置
# --------------------------------------------

# 是否开启调试模式 (生产环境必须设置为 false)
DEBUG=false

# API 前缀
API_PREFIX=/api/v1

# 时区设置
TIMEZONE=Asia/Shanghai

# 默认语言
DEFAULT_LANGUAGE=zh-CN

# --------------------------------------------
# 开发环境专用配置
# --------------------------------------------

# 是否自动重载代码 (仅开发环境)
RELOAD=false

# 开发服务器端口
BACKEND_PORT=8000
FRONTEND_PORT=8080
