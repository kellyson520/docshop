# DocShop 环境变量模板
# 使用前复制为 .env：
#   Windows PowerShell: Copy-Item .env.example .env
#   Linux/macOS:       cp .env.example .env

# -----------------------------
# 运行密钥
# -----------------------------
# auto = 容器每次启动自动生成临时密钥（new random key on every container start）；重启后旧登录 token/session 会失效。
# 生产长期使用建议改为固定随机值：
#   openssl rand -hex 32
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=auto

# -----------------------------
# Docker 暴露配置
# -----------------------------
# 宿主机访问端口。容器内部始终监听 80。
DOCSHOP_PORT=8080
DOCSHOP_IMAGE=docshop:latest

# 低占用默认值；大文件/并发多时可调高。
DOCKER_MEMORY_LIMIT=2G
DOCKER_CPU_LIMIT=2.0

# -----------------------------
# 应用运行配置
# -----------------------------
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json

# SQLite 和数据目录。docker-compose.yml 会把宿主机 ./data 挂载到容器 /app/data。
STORAGE_ROOT=/app/data
DATABASE_URL=sqlite:////app/data/docshop.db
UPLOAD_DIR=/app/data/uploads
LOG_DIR=/app/data/logs
TEMP_DIR=/app/data/temp

# 登录/session
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# 上传限制，默认 100 MiB。
MAX_FILE_SIZE=104857600
ALLOWED_FILE_TYPES=.pdf,.docx,.doc,.xlsx,.xls

# CORS。局域网单容器部署可用 *；公网域名建议改为精确 origin。
CORS_ORIGINS=*

# 反向代理 / 限流
TRUSTED_PROXY_IPS=127.0.0.1,::1
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX_KEYS=10000

# -----------------------------
# 预览生成
# -----------------------------
# Docker 镜像内置 LibreOffice + 中文字体，支持 DOC/DOCX/XLS/XLSX 转 PDF。
DOCX2PDF_TIMEOUT_SECONDS=300
PREVIEW_PDF_TIMEOUT_SECONDS=300

# 低占用默认 1。机器资源充足可改 2，但 SQLite + 单容器建议谨慎调高。
PREVIEW_IMAGE_MAX_WORKERS=1
UVICORN_WORKERS=1

# MobileModels 手机型号缓存（访问日志展示增强）
MOBILE_MODEL_SYNC_ENABLED=true
MOBILE_MODEL_SYNC_INTERVAL_HOURS=168
MOBILE_MODEL_SOURCE_URL=https://raw.githubusercontent.com/KHwang9883/MobileModels-csv/main/models.csv
MOBILE_MODEL_CACHE_DIR=/app/data/cache
MOBILE_MODEL_DOWNLOAD_TIMEOUT_SECONDS=15
MOBILE_MODEL_MAX_DOWNLOAD_BYTES=20971520

# -----------------------------
# 首次管理员初始化（可选）
# -----------------------------
# 仅当账号不存在时创建，不会覆盖已有管理员密码。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# -----------------------------
# Docker 构建加速
# -----------------------------
NODE_IMAGE=node:18.20.8-alpine3.20
PYTHON_IMAGE=python:3.11.11-slim-bookworm

# 基础镜像加速前缀。默认优先从候选镜像源中测速选择最快源，不先走 Docker Hub。
# DOCKER_BASE_MIRROR 留空：使用 DOCKER_MIRROR_CANDIDATES 自动测速。
# DOCKER_BASE_MIRROR=off：强制使用 Docker Hub 官方源（海外服务器可用）。
# DOCKER_MIRROR_CANDIDATES 支持逗号分隔；可带或不带 https://，脚本会自动规范化。
DOCKER_BASE_MIRROR=
DOCKER_MIRROR_CANDIDATES=docker.m.daocloud.io/library,registry.cn-hangzhou.aliyuncs.com/library
DOCKER_MIRROR_TIMEOUT_SECONDS=2

# Debian apt 镜像。国内服务器建议保留清华源。
# 官方源：
#   APT_MIRROR=http://deb.debian.org/debian
#   APT_SECURITY_MIRROR=http://deb.debian.org/debian-security
APT_MIRROR=http://mirrors.tuna.tsinghua.edu.cn/debian
APT_SECURITY_MIRROR=http://mirrors.tuna.tsinghua.edu.cn/debian-security

# Python 包镜像，避免 files.pythonhosted.org 下载慢/超时。
# 官方 PyPI：
#   PIP_INDEX_URL=https://pypi.org/simple
#   PIP_TRUSTED_HOST=
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn
